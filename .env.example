# Copy to .env and fill in real values. Never commit real credentials.

# Database (Supabase). Use the pooler URL for the app and the direct URL for cron locks.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres
SUPABASE_DIRECT_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

APP_BASE_URL=https://api.admin.lufasilodges.com
PORT=4000
NODE_ENV=PRODUCTION

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long-random-string>

PAYSTACK_SECRET_KEY=<paystack-secret-key>
PAYSTACK_PUBLIC_KEY=<paystack-public-key>
#PAYSTACK_CALLBACK_URL=http://localhost:3000/payments/callback

SQUADCO_API_KEY=<squad-public-key>
SQUADCO_SECRET_KEY=<squad-secret-key>
SQUADCO_BASE_URL=https://api-d.squadco.com
#SQUADCO_CALLBACK_URL=http://localhost:3000/payments/callback

DEFAULT_PAYMENT_GATEWAY=paystack
PAYMENT_CURRENCY=NGN

EMAIL_PROVIDER=gmail

EMAIL_FROM_NAME=Lufasi Lodges
EMAIL_FROM_ADDRESS=bookings@lufasilodges.com

GMAIL_USER=bookings@lufasilodges.com
GMAIL_APP_PASSWORD=<gmail-app-password>

ADMIN_EMAIL=bookings@lufasilodges.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASSWORD=<smtp-password>

EMAIL_BOOKING_CONFIRMATION=true
EMAIL_PAYMENT_SUCCESS=true
EMAIL_PAYMENT_FAILED=true
EMAIL_BOOKING_CANCELLATION=true
EMAIL_BOOKING_REMINDER=true

FRONTEND_URL=https://booking.lufasilodges.com

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Channex Channel Manager (being replaced by Beds24)
CHANNEX_ENABLED=false
CHANNEX_API_KEY=
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_PROPERTY_ID=
CHANNEX_ROOM_TYPE_ID=
CHANNEX_RATE_PLAN_ID=
# Required when CHANNEX_ENABLED=true: webhook calls are rejected without it.
CHANNEX_WEBHOOK_SECRET=
CHANNEX_ARI_WINDOW_DAYS=365
# Rates pushed to OTAs are the pre-tax base price. Set CHANNEX_RATES_EX_VAT=true
# only to divide by (1 + VAT_RATE) before pushing.
# CHANNEX_RATES_EX_VAT=false
VAT_RATE=0.125

# Beds24 channel manager (API v2). Run scripts/beds24-setup.js to get the refresh token.
BEDS24_ENABLED=false
BEDS24_BASE_URL=https://beds24.com/api/v2
BEDS24_REFRESH_TOKEN=
BEDS24_PROPERTY_ID=
BEDS24_ROOM_ID=
# Required when BEDS24_ENABLED=true: webhook calls are rejected without it.
# Use it in the Beds24 webhook URL: https://<api-host>/beds24/webhook?secret=<value>
BEDS24_WEBHOOK_SECRET=
BEDS24_ARI_WINDOW_DAYS=365
BEDS24_MIN_STAY=1
# absolute (default) or beds24-subtracts. Confirm on the first test; see the QA checklist.
BEDS24_AVAIL_MODE=absolute
# Do not enable Channex and Beds24 together: both would push availability.
